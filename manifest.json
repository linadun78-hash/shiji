{
  "manifest_version": 3,
  "name": "拾集：小红书任务素材助手",
  "version": "0.3.0",
  "description": "把当前可见的小红书图文笔记主动拾取到任务素材箱。",
  "permissions": [
    "storage",
    "downloads",
    "identity"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "http://127.0.0.1:8765/*",
    "https://*.auth0.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background-bundle.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "src/runtime-env.js",
        "src/runtime-config.js",
        "src/material.js",
        "src/xhs-adapter.js",
      "src/repository.js",
      "src/analysis-repository.js",
      "src/report-repository.js",
      "src/tutorial-manual-repository.js",
    "src/provider-presets.js",
    "src/ui-model.js",
    "src/vendor/html2canvas.min.js",
    "src/workbook-export.js",
    "src/content.js"
      ],
      "css": [
        "src/content.css",
        "src/export-rgb.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/shiji-mark.svg",
        "src/content.css",
        "src/export-rgb.css"
      ],
      "matches": [
        "https://www.xiaohongshu.com/*"
      ]
    }
  ]
}
